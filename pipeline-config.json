{
  "templates": "pipeline-templates.json",
  "workflows": "pipeline-workflows.json",
  "template_directory": "templates",
  "rotation": {
    "deviation": 2,
    "ignore_sides_fraction": 0.15,
    "ignore_top_fraction": 0.05,
    "ignore_bottom_fraction": 0.05,
    "mode_bins": 21
  },
  "margin_detection": {
    "left_right_limit": 0.25,
    "top_bottom_limit": 0.20,
    "left_right_test": 0.10,
    "fallback_side_test": 100,
    "smoothing_window": 10,
    "black_limit": 0.75,
    "min_width": 4080
  },
  "registration": {
    "hlines": {
      "smoothing_window": 5,
      "min_distance": 50,
      "max_distance": 100
    },
    "horizontal": {
      "deviation": 1.5
    },
    "vertical": {
      "deviation": 1.0
    },
    "cutoff_adjustments": {
      "left": 90,
      "right": 150,
      "top": 160,
      "top_band": 550,
      "bottom": 25
    }
  }
}